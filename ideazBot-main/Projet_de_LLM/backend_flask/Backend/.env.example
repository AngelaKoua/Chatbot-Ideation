# Copier ce fichier en .env pour le développement local.
# En ligne, définir ces variables dans l'interface de l'hébergeur (Render).

# Obligatoire : clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modèle Groq utilisé (facultatif)
GROQ_MODEL=openai/gpt-oss-120b

# Obligatoire en ligne : clé de signature des tokens
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Base de données : vide en local (SQLite), URL PostgreSQL en ligne (Neon, Supabase…)
# Exemple : postgresql://utilisateur:motdepasse@hote/base?sslmode=require
DATABASE_URL=

# URL(s) du frontend autorisées par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:3000

# Facultatif : envoi de la mindmap par email (mot de passe d'application Gmail)
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
